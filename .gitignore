# Secrets and local env (patterns without a leading slash match at any depth)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets/
.secrets/
service-account*.json
credentials*.json

# Supabase CLI local state
.supabase/
**/supabase/.temp/
**/supabase/.branches/

