# Web app environment template. Copy to `.env.local` (git-ignored).
# Only NEXT_PUBLIC_ values reach the browser, so never put secrets in them.
# The Supabase service-role key must never appear here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Phase 1+ (leave blank until a Supabase project is approved):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
