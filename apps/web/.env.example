# Web app environment template. Copy to `apps/web/.env.local` (git-ignored).
#
# Only NEXT_PUBLIC_ values are sent to the browser, so nothing secret may ever use that prefix.
# The publishable key is designed to be public (it maps to the low-privilege anon/authenticated
# roles; our data is in a schema it cannot reach) but is still kept out of git.
# Never put the Supabase secret key (sb_secret_...) or the legacy service_role key here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo mode: fictional sample data held in the browser, no backend and no sign-in. A banner is shown on
# every screen while it is on. Leave it unset (or anything other than the exact word true) for real use.
# NEXT_PUBLIC_DEMO_MODE=true
