# Alembic-only credentials. Copy it OUTSIDE the repository to
# ~/.config/vendortrust/migrations.env, then: chmod 700 ~/.config/vendortrust && chmod 600 <file>
#
# Loaded ONLY by the migration tooling (Phase 1.3), never by the API server. The loader accepts
# exactly one name (VT_MIGRATION_DATABASE_URL), requires a vt_migrator user, and a process that
# has VT_DATABASE_URL set refuses to load it. Never export this in a shell that runs the API,
# and never put it in CI secrets for the application deploy.
#
# Role vt_migrator owns schema `vt` and its tables. It is not a superuser and does not bypass
# row level security. Use the direct or session-mode pooler connection (never transaction mode).
VT_MIGRATION_DATABASE_URL=postgresql+psycopg://vt_migrator.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
