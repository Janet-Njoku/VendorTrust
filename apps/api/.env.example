# VendorTrust environment template (API + local tooling)
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.
# Every value below is a placeholder. Phase 0 does not connect to Supabase.

# --- API ---
VT_ENVIRONMENT=development          # development | test | production
VT_LOG_LEVEL=INFO
# Comma-separated explicit origins. Never use "*".
VT_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Phase 1+) ---
# Use a least-privilege application role, not the Supabase `postgres`/service role.
VT_DATABASE_URL=postgresql+psycopg://vendortrust_app:CHANGE_ME@localhost:5432/vendortrust

# --- Supabase (Phase 1+; leave blank until a project is approved) ---
VT_SUPABASE_URL=
VT_SUPABASE_JWKS_URL=
VT_SUPABASE_JWT_AUDIENCE=authenticated
# Server-side only. Must never be exposed to the browser or prefixed NEXT_PUBLIC_.
VT_SUPABASE_SERVICE_ROLE_KEY=

# --- Evidence storage (Phase 4+) ---
VT_EVIDENCE_BUCKET=evidence-private
VT_EVIDENCE_MAX_BYTES=26214400
VT_SIGNED_URL_TTL_SECONDS=300

# --- Malware scanning (dev: docker compose service `clamav`) ---
VT_CLAMAV_HOST=localhost
VT_CLAMAV_PORT=3310
