# VendorTrust API environment template. Copy it OUTSIDE the repository to
# ~/.config/vendortrust/api.env, then: chmod 700 ~/.config/vendortrust && chmod 600 <file>
# The app loads it only when database functionality needs credentials (never on import), and
# refuses files that are group/world-accessible, symlinks, or inside the git repository.
#
# Strict format: NAME=value lines, `#` comments, optional quotes, no ${VAR} expansion, and only
# the names listed below. Real process environment variables override this file.
# Production never reads the default folder: set VT_DATABASE_URL, or VT_ENV_FILE explicitly.
#
# Every value is a placeholder. Real values live only in your private copy, never in git,
# logs, chat or the browser. Migration credentials go in a SEPARATE file (migrations.env).
#
# Deliberately absent: the Supabase secret key (sb_secret_...), the legacy service_role key,
# the legacy JWT secret and the `postgres` password. The API needs none of them and must
# never hold them. See docs/phase1-design.md.

# --- API ---
VT_ENVIRONMENT=development          # development | test | production
VT_LOG_LEVEL=INFO
# Comma-separated explicit origins. Never use "*".
VT_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (runtime role vt_app: no superuser, no BYPASSRLS, owns nothing) ---
# Dev via the Supabase session-mode pooler (IPv4, port 5432); the pooler user is
# vt_app.<project-ref>. Remote connections must use sslmode=require or stronger.
VT_DATABASE_URL=postgresql+psycopg://vt_app.PROJECT_REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- Supabase Auth (public values; used to verify JWTs via JWKS) ---
VT_SUPABASE_URL=https://PROJECT_REF.supabase.co
VT_SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
VT_SUPABASE_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
VT_SUPABASE_JWT_AUDIENCE=authenticated

# --- Authorization ---
# Require TOTP (aal2) for internal roles. Keep true everywhere except a throwaway dev setup.
VT_ENFORCE_MFA_INTERNAL=true

# --- Evidence storage (Phase 4+) ---
VT_EVIDENCE_BUCKET=evidence-private
VT_EVIDENCE_MAX_BYTES=26214400
VT_SIGNED_URL_TTL_SECONDS=300

# --- Malware scanning (Phase 4+; dev: docker compose service `clamav`) ---
VT_CLAMAV_HOST=localhost
VT_CLAMAV_PORT=3310
